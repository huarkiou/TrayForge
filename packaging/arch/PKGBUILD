# Maintainer: huarkiou <huarkiou@example.com>
# Build from a release bundle: ../../scripts/package-arch.sh

pkgname=trayforge
pkgver=1.0.0
pkgrel=1
pkgdesc="System-tray process manager: define processes in a JSON config and keep them running"
arch=('x86_64')
url="https://github.com/huarkiou/trayforge"
license=('custom')
depends=('gtk3' 'libayatana-appindicator')
source=("trayforge-bundle.tar.gz" "trayforge.desktop" "trayforge.png")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  # Flutter resolves data/ and lib/ relative to the real executable path
  # (/proc/self/exe), so install the binary under /usr/lib/trayforge and
  # symlink it from /usr/bin.
  install -Dm755 "${srcdir}/trayforge" "${pkgdir}/usr/lib/trayforge/trayforge"
  install -d -m755 "${pkgdir}/usr/lib/trayforge/data" "${pkgdir}/usr/lib/trayforge/lib"
  cp -r "${srcdir}/data/." "${pkgdir}/usr/lib/trayforge/data/"
  cp -r "${srcdir}/lib/." "${pkgdir}/usr/lib/trayforge/lib/"
  # The bundle ships with restrictive perms (built from a Windows mount),
  # which would leave root-owned 750 dirs unreadable by users. Normalise:
  # read for all, exec for dirs and already-executable files.
  chmod -R a+rX "${pkgdir}/usr/lib/trayforge"
  install -d "${pkgdir}/usr/bin"
  ln -s /usr/lib/trayforge/trayforge "${pkgdir}/usr/bin/trayforge"

  install -Dm644 "${srcdir}/trayforge.desktop" \
    "${pkgdir}/usr/share/applications/trayforge.desktop"
  install -Dm644 "${srcdir}/trayforge.png" \
    "${pkgdir}/usr/share/icons/hicolor/64x64/apps/trayforge.png"
}
